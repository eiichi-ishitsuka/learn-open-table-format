# このファイルを .env にコピーし、ご自身の GCP 環境に合わせて値を設定してください。
# .env は .gitignore 対象のため Git にはコミットされません。

GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=asia-northeast1

# GCS バケット名（本番では Landing 用と Lakehouse 用を分離することを推奨）
GCS_LANDING_BUCKET=your-landing-bucket
GCS_LAKEHOUSE_BUCKET=your-lakehouse-bucket

# BigQuery の既存データセット名・テーブル名・Landing プレフィックス
GCS_LANDING_PREFIX=handson_schema_evolution/landing
BQ_DATASET=your_bigquery_dataset
ICEBERG_TABLE_NAME=users_master

# ハンズオン 02（BigQuery 管理 Iceberg テーブル）用
BQ_CONNECTION_ID=biglake-iceberg-conn
BQ_MANAGED_TABLE_NAME=users_master_bq_managed
